#:import NoTransition kivy.uix.screenmanager.NoTransition

<HeaderBar@BoxLayout>:
    size_hint_y: None
    height: 60
    padding: [25, 10]
    canvas.before:
        Color:
            rgba: 0.02, 0.12, 0.25, 1
        Rectangle:
            pos: self.pos
            size: self.size
        Color:
            rgba: 0.95, 0.61, 0.07, 1
        Rectangle:
            pos: self.x, self.y
            size: self.width, 3
    Label:
        text: "[b][color=f39c12]FortiBank ATM[/color][/b] | SASE SUMMIT"
        markup: True
        font_size: '22sp'
        halign: 'left'
        valign: 'middle'
        text_size: self.size
    Label:
        id: clock_lbl
        text: app.clock_text
        font_size: '20sp'
        bold: True
        halign: 'right'
        valign: 'middle'
        text_size: self.size

<AtmButton@Button>:
    background_normal: ''
    background_color: 0.12, 0.35, 0.58, 1
    color: 1, 1, 1, 1
    font_size: '22sp'
    bold: True

<CancelButton@Button>:
    background_normal: ''
    background_color: 0.91, 0.30, 0.24, 1
    color: 1, 1, 1, 1
    font_size: '20sp'
    bold: True

<ScreenBase>:
    canvas.before:
        Color:
            rgba: 0.04, 0.23, 0.44, 1
        Rectangle:
            pos: self.pos
            size: self.size

<Manager>:
    transition: NoTransition()
    ScreenInsert:
        name: 'insert'
    ScreenPin:
        name: 'pin'
    ScreenMenu:
        name: 'menu'
    ScreenAmount:
        name: 'amount'
    ScreenProcessing:
        name: 'processing'
    ScreenDispensing:
        name: 'dispensing'
    ScreenResult:
        name: 'result'

<ScreenInsert>:
    BoxLayout:
        orientation: 'vertical'
        HeaderBar:
        BoxLayout:
            orientation: 'vertical'
            padding: [30, 20]
            spacing: 10
            Label:
                text: "Deslice para seleccionar su tarjeta"
                font_size: '30sp'
                bold: True
                size_hint_y: None
                height: 45
            Label:
                text: "(Arrastre izquierda/derecha y toque una tarjeta para insertarla)"
                font_size: '16sp'
                color: 0.75, 0.82, 0.9, 1
                size_hint_y: None
                height: 25
            Carousel:
                id: card_carousel
                direction: 'right'
                loop: True

<ScreenPin>:
    BoxLayout:
        orientation: 'vertical'
        HeaderBar:
        BoxLayout:
            orientation: 'horizontal'
            padding: [40, 25]
            spacing: 40
            BoxLayout:
                orientation: 'vertical'
                size_hint_x: 0.42
                spacing: 20
                Label:
                    text: "Ingrese su NIP\nde 4 dígitos"
                    font_size: '28sp'
                    bold: True
                    halign: 'center'
                    valign: 'middle'
                    text_size: self.size
                Label:
                    id: nip_display
                    text: ""
                    font_size: '46sp'
                    bold: True
                    color: 0.1, 0.1, 0.1, 1
                    size_hint_y: None
                    height: 75
                    canvas.before:
                        Color:
                            rgba: 1, 1, 1, 1
                        RoundedRectangle:
                            pos: self.pos
                            size: self.size
                            radius: [10]
                CancelButton:
                    text: "CANCELAR OPERACIÓN"
                    size_hint_y: None
                    height: 65
                    on_release: app.eject_card()
            GridLayout:
                cols: 3
                spacing: 12
                size_hint_x: 0.58
                AtmButton:
                    text: "1"
                    on_release: root.append_nip("1")
                AtmButton:
                    text: "2"
                    on_release: root.append_nip("2")
                AtmButton:
                    text: "3"
                    on_release: root.append_nip("3")
                AtmButton:
                    text: "4"
                    on_release: root.append_nip("4")
                AtmButton:
                    text: "5"
                    on_release: root.append_nip("5")
                AtmButton:
                    text: "6"
                    on_release: root.append_nip("6")
                AtmButton:
                    text: "7"
                    on_release: root.append_nip("7")
                AtmButton:
                    text: "8"
                    on_release: root.append_nip("8")
                AtmButton:
                    text: "9"
                    on_release: root.append_nip("9")
                Button:
                    text: "BORRAR"
                    background_normal: ''
                    background_color: 0.90, 0.49, 0.13, 1
                    font_size: '18sp'
                    bold: True
                    on_release: root.clear_nip()
                AtmButton:
                    text: "0"
                    on_release: root.append_nip("0")
                Button:
                    text: "ENTRAR"
                    background_normal: ''
                    background_color: 0.15, 0.68, 0.38, 1
                    font_size: '18sp'
                    bold: True
                    on_release: root.submit_nip()

<ScreenMenu>:
    BoxLayout:
        orientation: 'vertical'
        HeaderBar:
        BoxLayout:
            orientation: 'vertical'
            padding: [80, 40]
            spacing: 30
            Label:
                text: "Seleccione una operación"
                font_size: '32sp'
                bold: True
                size_hint_y: None
                height: 50
            GridLayout:
                cols: 2
                spacing: 30
                AtmButton:
                    text: "RETIRO DE EFECTIVO"
                    on_release: app.go_to('amount')
                AtmButton:
                    text: "CONSULTA DE SALDO"
                    on_release: app.start_transaction(0, False)
            CancelButton:
                text: "CANCELAR Y RETIRAR TARJETA"
                size_hint_y: None
                height: 65
                on_release: app.eject_card()

<ScreenAmount>:
    BoxLayout:
        orientation: 'vertical'
        HeaderBar:
        BoxLayout:
            orientation: 'vertical'
            padding: [60, 25]
            spacing: 20
            Label:
                text: "Seleccione la cantidad a retirar"
                font_size: '30sp'
                bold: True
                size_hint_y: None
                height: 45
            GridLayout:
                cols: 2
                spacing: 15
                AtmButton:
                    text: "$ 100 MXN"
                    on_release: app.start_transaction(100, True)
                AtmButton:
                    text: "$ 200 MXN"
                    on_release: app.start_transaction(200, True)
                AtmButton:
                    text: "$ 500 MXN"
                    on_release: app.start_transaction(500, True)
                AtmButton:
                    text: "$ 1,000 MXN"
                    on_release: app.start_transaction(1000, True)
                AtmButton:
                    text: "$ 2,000 MXN"
                    on_release: app.start_transaction(2000, True)
                AtmButton:
                    text: "$ 3,000 MXN"
                    on_release: app.start_transaction(3000, True)
                AtmButton:
                    text: "$ 5,000 MXN"
                    on_release: app.start_transaction(5000, True)
                CancelButton:
                    text: "REGRESAR"
                    on_release: app.go_to('menu')

<ScreenProcessing>:
    BoxLayout:
        orientation: 'vertical'
        HeaderBar:
        BoxLayout:
            orientation: 'vertical'
            padding: [60, 40]
            spacing: 20
            Label:
                id: proc_msg
                text: "Procesando por red Fortinet ZTNA..."
                font_size: '30sp'
                bold: True
            Label:
                id: timer_lbl
                text: "Tiempo restante: 30s"
                font_size: '22sp'
                color: 0.95, 0.61, 0.07, 1
                bold: True
            Label:
                id: iso_proc_lbl
                text: "[SYS] Conectando al Core Bancario (192.168.27.35)..."
                font_size: '16sp'
                color: 0.18, 0.80, 0.44, 1
                halign: 'left'
                valign: 'top'
                text_size: self.size
                padding: [15, 15]
                canvas.before:
                    Color:
                        rgba: 0, 0, 0, 0.85
                    Rectangle:
                        pos: self.pos
                        size: self.size

<ScreenDispensing>:
    BoxLayout:
        orientation: 'vertical'
        HeaderBar:
        BoxLayout:
            orientation: 'vertical'
            padding: [40, 20]
            spacing: 10
            Label:
                id: disp_title
                text: "Contando billetes..."
                font_size: '30sp'
                bold: True
                size_hint_y: None
                height: 45
            Label:
                id: disp_sub
                text: "Por favor espere"
                font_size: '20sp'
                size_hint_y: None
                height: 30
            FloatLayout:
                id: bill_area
                Widget:
                    size_hint: None, None
                    size: 420, 22
                    pos_hint: {'center_x': 0.5, 'top': 0.95}
                    canvas:
                        Color:
                            rgba: 0.05, 0.05, 0.05, 1
                        RoundedRectangle:
                            pos: self.pos
                            size: self.size
                            radius: [6]

<ScreenResult>:
    BoxLayout:
        orientation: 'vertical'
        HeaderBar:
        BoxLayout:
            orientation: 'vertical'
            padding: [60, 25]
            spacing: 18
            Label:
                id: res_title
                text: "Operación Exitosa"
                font_size: '32sp'
                bold: True
                color: 0.18, 0.80, 0.44, 1
                size_hint_y: None
                height: 45
            Label:
                id: res_detail
                text: "Saldo Disponible: $0.00 MXN"
                font_size: '26sp'
                bold: True
                size_hint_y: None
                height: 55
                canvas.before:
                    Color:
                        rgba: 0, 0, 0, 0.4
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [8]
            Label:
                id: res_iso
                text: "[SYS] Tráfico SASE Inspeccionado:"
                font_size: '15sp'
                color: 0.18, 0.80, 0.44, 1
                halign: 'left'
                valign: 'top'
                text_size: self.size
                padding: [15, 12]
                canvas.before:
                    Color:
                        rgba: 0, 0, 0, 0.85
                    Rectangle:
                        pos: self.pos
                        size: self.size
            BoxLayout:
                orientation: 'horizontal'
                spacing: 30
                size_hint_y: None
                height: 65
                AtmButton:
                    text: "OTRO MOVIMIENTO"
                    background_color: 0.95, 0.61, 0.07, 1
                    on_release: app.go_to('menu')
                CancelButton:
                    text: "RETIRAR TARJETA"
                    on_release: app.eject_card()
