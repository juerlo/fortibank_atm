#:import NoTransition kivy.uix.screenmanager.NoTransition

<HeaderBar@BoxLayout>:
    size_hint_y: None
    height: 64
    padding: [30, 15]
    canvas.before:
        Color:
            rgba: 0, 0, 0, 0.4
        Rectangle:
            pos: self.pos
            size: self.size
        Color:
            rgba: 0.953, 0.612, 0.071, 1
        Rectangle:
            pos: self.x, self.y
            size: self.width, 3
    Label:
        text: "[b][color=f39c12][size=28]FortiBank ATM[/size][/color][/b]"
        markup: True
        halign: 'left'
        valign: 'middle'
        text_size: self.size
    Label:
        id: clock_lbl
        text: app.clock_text
        font_size: '24sp'
        bold: True
        halign: 'right'
        valign: 'middle'
        text_size: self.size

<AtmButton@Button>:
    background_normal: ''
    background_color: 0.12, 0.35, 0.58, 1
    color: 1, 1, 1, 1
    font_size: '22sp'
    bold: True

<CancelButton@Button>:
    background_normal: ''
    background_color: 0.91, 0.30, 0.24, 1
    color: 1, 1, 1, 1
    font_size: '20sp'
    bold: True

<NumKey@Button>:
    background_normal: ''
    background_color: 0.925, 0.941, 0.945, 1
    color: 0.2, 0.2, 0.2, 1
    font_size: '26sp'
    bold: True

<ClearKey@Button>:
    background_normal: ''
    background_color: 0.902, 0.494, 0.133, 1
    color: 1, 1, 1, 1
    font_size: '18sp'
    bold: True

<EnterKey@Button>:
    background_normal: ''
    background_color: 0.153, 0.682, 0.376, 1
    color: 1, 1, 1, 1
    font_size: '18sp'
    bold: True

<MenuButton@Button>:
    background_normal: ''
    background_color: 1, 1, 1, 0.10
    color: 1, 1, 1, 1
    font_size: '22sp'
    bold: True

<ScreenBase>:
    canvas.before:
        Color:
            rgba: 0.04, 0.23, 0.44, 1
        Rectangle:
            pos: self.pos
            size: self.size

<Manager>:
    transition: NoTransition()
    ScreenInsert:
        name: 'insert'
    ScreenPin:
        name: 'pin'
    ScreenMenu:
        name: 'menu'
    ScreenAmount:
        name: 'amount'
    ScreenProcessing:
        name: 'processing'
    ScreenDispensing:
        name: 'dispensing'
    ScreenResult:
        name: 'result'
    ScreenCardAnim:
        name: 'cardanim'

<ScreenInsert>:
    BoxLayout:
        orientation: 'vertical'
        HeaderBar:
        BoxLayout:
            orientation: 'vertical'
            padding: [30, 20]
            spacing: 10
            Label:
                text: "Deslice para seleccionar su tarjeta"
                font_size: '32sp'
                bold: True
                color: 1, 1, 1, 1
                size_hint_y: None
                height: 50
                halign: 'center'
                valign: 'middle'
                text_size: self.size
            Label:
                text: "(Deslice izquierda/derecha y presione una tarjeta)"
                font_size: '15sp'
                color: 0.667, 0.667, 0.667, 1
                size_hint_y: None
                height: 25
                halign: 'center'
                valign: 'middle'
                text_size: self.size
            ScrollView:
                id: card_scroll
                size_hint_y: None
                height: 300
                do_scroll_x: True
                do_scroll_y: False
                scroll_wheel_distance: 20
                BoxLayout:
                    id: card_container
                    orientation: 'horizontal'
                    size_hint_x: None
                    width: self.minimum_width
                    spacing: 20
                    padding: [0, 20, 0, 20]

<ScreenPin>:
    BoxLayout:
        orientation: 'vertical'
        HeaderBar:
        Widget:
            size_hint_y: 1
        Label:
            text: "Ingrese su NIP de 4 dígitos"
            font_size: '30sp'
            bold: True
            size_hint_y: None
            height: 50
            halign: 'center'
            valign: 'middle'
            text_size: self.size
        AnchorLayout:
            size_hint_y: None
            height: 92
            Label:
                id: nip_display
                text: ""
                font_size: '44sp'
                bold: True
                color: 0.067, 0.067, 0.067, 1
                size_hint: None, None
                size: 250, 70
                halign: 'center'
                valign: 'middle'
                text_size: self.size
                canvas.before:
                    Color:
                        rgba: 1, 1, 1, 1
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [8]
        AnchorLayout:
            size_hint_y: None
            height: 262
            GridLayout:
                cols: 3
                spacing: 10
                size_hint: None, None
                size: 320, 262
                NumKey:
                    text: "1"
                    on_release: root.append_nip("1")
                NumKey:
                    text: "2"
                    on_release: root.append_nip("2")
                NumKey:
                    text: "3"
                    on_release: root.append_nip("3")
                NumKey:
                    text: "4"
                    on_release: root.append_nip("4")
                NumKey:
                    text: "5"
                    on_release: root.append_nip("5")
                NumKey:
                    text: "6"
                    on_release: root.append_nip("6")
                NumKey:
                    text: "7"
                    on_release: root.append_nip("7")
                NumKey:
                    text: "8"
                    on_release: root.append_nip("8")
                NumKey:
                    text: "9"
                    on_release: root.append_nip("9")
                ClearKey:
                    text: "BORRAR"
                    on_release: root.clear_nip()
                NumKey:
                    text: "0"
                    on_release: root.append_nip("0")
                EnterKey:
                    text: "ENTRAR"
                    on_release: root.submit_nip()
        AnchorLayout:
            size_hint_y: None
            height: 78
            CancelButton:
                text: "CANCELAR OPERACIÓN"
                size_hint: None, None
                size: 260, 58
                on_release: app.eject_card()
        Widget:
            size_hint_y: 1

<ScreenMenu>:
    BoxLayout:
        orientation: 'vertical'
        HeaderBar:
        BoxLayout:
            orientation: 'vertical'
            padding: [80, 40]
            spacing: 30
            Label:
                text: "Seleccione una operación"
                font_size: '32sp'
                bold: True
                size_hint_y: None
                height: 50
            GridLayout:
                cols: 2
                spacing: 20
                size_hint_y: None
                height: 180
                MenuButton:
                    text: "RETIRO DE EFECTIVO"
                    on_release: app.go_to('amount')
                MenuButton:
                    text: "CONSULTA DE SALDO"
                    on_release: app.start_transaction(0, False)
            CancelButton:
                text: "CANCELAR Y RETIRAR TARJETA"
                size_hint_y: None
                height: 65
                on_release: app.eject_card()

<ScreenAmount>:
    BoxLayout:
        orientation: 'vertical'
        HeaderBar:
        BoxLayout:
            orientation: 'vertical'
            padding: [60, 25]
            spacing: 20
            Label:
                text: "Seleccione la cantidad a retirar"
                font_size: '30sp'
                bold: True
                size_hint_y: None
                height: 45
            GridLayout:
                cols: 2
                spacing: 15
                AtmButton:
                    text: "$ 100 MXN"
                    on_release: app.start_transaction(100, True)
                AtmButton:
                    text: "$ 200 MXN"
                    on_release: app.start_transaction(200, True)
                AtmButton:
                    text: "$ 500 MXN"
                    on_release: app.start_transaction(500, True)
                AtmButton:
                    text: "$ 1,000 MXN"
                    on_release: app.start_transaction(1000, True)
                AtmButton:
                    text: "$ 2,000 MXN"
                    on_release: app.start_transaction(2000, True)
                AtmButton:
                    text: "$ 3,000 MXN"
                    on_release: app.start_transaction(3000, True)
                AtmButton:
                    text: "$ 5,000 MXN"
                    on_release: app.start_transaction(5000, True)
                CancelButton:
                    text: "REGRESAR"
                    on_release: app.go_to('menu')

<ScreenProcessing>:
    BoxLayout:
        orientation: 'vertical'
        HeaderBar:
        BoxLayout:
            orientation: 'vertical'
            padding: [60, 40]
            spacing: 20
            Label:
                id: proc_msg
                text: "Procesando por red Fortinet ZTNA..."
                font_size: '30sp'
                bold: True
            Label:
                id: timer_lbl
                text: "Tiempo restante: 30s"
                font_size: '22sp'
                color: 0.95, 0.61, 0.07, 1
                bold: True
            Label:
                id: iso_proc_lbl
                text: "[SYS] Conectando al Core Bancario (192.168.27.35)..."
                font_size: '16sp'
                color: 0.18, 0.80, 0.44, 1
                halign: 'left'
                valign: 'top'
                text_size: self.size
                padding: [15, 15]
                canvas.before:
                    Color:
                        rgba: 0, 0, 0, 0.85
                    Rectangle:
                        pos: self.pos
                        size: self.size

<ScreenDispensing>:
    BoxLayout:
        orientation: 'vertical'
        HeaderBar:
        BoxLayout:
            orientation: 'vertical'
            padding: [40, 20]
            spacing: 10
            Label:
                id: disp_title
                text: "Contando billetes..."
                font_size: '30sp'
                bold: True
                size_hint_y: None
                height: 45
            Label:
                id: disp_sub
                text: "Por favor espere"
                font_size: '20sp'
                size_hint_y: None
                height: 30
            FloatLayout:
                id: bill_area
                Widget:
                    size_hint: None, None
                    size: 420, 22
                    pos_hint: {'center_x': 0.5, 'top': 0.95}
                    canvas:
                        Color:
                            rgba: 0.05, 0.05, 0.05, 1
                        RoundedRectangle:
                            pos: self.pos
                            size: self.size
                            radius: [6]

<ScreenResult>:
    BoxLayout:
        orientation: 'vertical'
        HeaderBar:
        BoxLayout:
            orientation: 'vertical'
            padding: [60, 25]
            spacing: 18
            Label:
                id: res_title
                text: "Operación Exitosa"
                font_size: '32sp'
                bold: True
                color: 0.18, 0.80, 0.44, 1
                size_hint_y: None
                height: 45
            Label:
                id: res_detail
                text: "Saldo Disponible: $0.00 MXN"
                font_size: '26sp'
                bold: True
                size_hint_y: None
                height: 55
                canvas.before:
                    Color:
                        rgba: 0, 0, 0, 0.4
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [8]
            Label:
                id: res_iso
                text: "[SYS] Tráfico SASE Inspeccionado:"
                font_size: '15sp'
                color: 0.18, 0.80, 0.44, 1
                halign: 'left'
                valign: 'top'
                text_size: self.size
                padding: [15, 12]
                canvas.before:
                    Color:
                        rgba: 0, 0, 0, 0.85
                    Rectangle:
                        pos: self.pos
                        size: self.size
            BoxLayout:
                orientation: 'horizontal'
                spacing: 30
                size_hint_y: None
                height: 65
                AtmButton:
                    text: "OTRO MOVIMIENTO"
                    background_color: 0.95, 0.61, 0.07, 1
                    on_release: app.go_to('menu')
                CancelButton:
                    text: "RETIRAR TARJETA"
                    on_release: app.eject_card()
