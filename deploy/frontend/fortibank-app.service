[Unit]
Description=FortiBank ATM application
After=fortibank-x.service
Requires=fortibank-x.service

[Service]
Type=simple
User=orangepi
SupplementaryGroups=video render
Environment=DISPLAY=:2
WorkingDirectory=/home/orangepi/fortibank_atm
ExecStart=/home/orangepi/fortibank_atm/start_atm.sh
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
