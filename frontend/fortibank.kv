#:import NoTransition kivy.uix.screenmanager.NoTransition

<HeaderBar@BoxLayout>:
    orientation: 'horizontal'
    size_hint_y: None
    height: app.s(64)
    padding: [30, 15]
    canvas.before:
        Color:
            rgba: 0, 0, 0, 0.4
        Rectangle:
            pos: self.pos
            size: self.size
        Color:
            rgba: 0.953, 0.612, 0.071, 1
        Rectangle:
            pos: self.x, self.y
            size: self.width, 3
    Button:
        text: "[b][color=f39c12][size=28]FortiBank ATM[/size][/color][/b]"
        markup: True
        halign: 'left'
        valign: 'middle'
        text_size: self.size
        background_normal: ''
        background_color: 0, 0, 0, 0
        on_release: app.register_admin_tap()
    Button:
        id: clock_lbl
        text: app.clock_text
        font_size: app.sfont(24)
        bold: True
        color: 1, 1, 1, 1
        halign: 'right'
        valign: 'middle'
        text_size: self.size
        background_normal: ''
        background_down: ''
        background_color: 0, 0, 0, 0
        on_release: app.register_clock_tap()

<BorderButton@PushButton>:
    background_normal: ''
    canvas.after:
        Color:
            rgba: 1, 1, 1, 0.40
        Line:
            rounded_rectangle: self.x, self.y, self.width, self.height, 8
            width: 1

<AtmButton@BorderButton>:
    background_color: 0.12, 0.35, 0.58, 1
    color: 1, 1, 1, 1
    font_size: app.sfont(22)
    bold: True

<CancelButton@BorderButton>:
    background_color: 0.91, 0.30, 0.24, 1
    color: 1, 1, 1, 1
    font_size: app.sfont(20)
    bold: True

<NumKey@PushButton>:
    background_normal: ''
    background_color: 0.925, 0.941, 0.945, 1
    color: 0.2, 0.2, 0.2, 1
    font_size: '26sp'
    bold: True

<ClearKey@PushButton>:
    background_normal: ''
    background_color: 0.902, 0.494, 0.133, 1
    color: 1, 1, 1, 1
    font_size: '18sp'
    bold: True

<EnterKey@PushButton>:
    background_normal: ''
    background_color: 0.153, 0.682, 0.376, 1
    color: 1, 1, 1, 1
    font_size: '18sp'
    bold: True

<PinCancelButton@PushButton>:
    background_normal: ''
    background_color: 0.91, 0.30, 0.24, 1
    color: 1, 1, 1, 1
    font_size: '18sp'
    bold: True

<MenuButton@PushButton>:
    background_normal: ''
    background_color: 1, 1, 1, 0.10
    color: 1, 1, 1, 1
    font_size: '22sp'
    bold: True
    canvas.after:
        Color:
            rgba: 1, 1, 1, 0.50
        Line:
            rounded_rectangle: self.x, self.y, self.width, self.height, 8
            width: 1.5

<ScreenBase>:
    canvas.before:
        Color:
            rgba: 0.04, 0.23, 0.44, 1
        Rectangle:
            pos: self.pos
            size: self.size

<Manager>:
    transition: NoTransition()
    ScreenInsert:
        name: 'insert'
    ScreenPin:
        name: 'pin'
    ScreenMenu:
        name: 'menu'
    ScreenAmount:
        name: 'amount'
    ScreenProcessing:
        name: 'processing'
    ScreenDispensing:
        name: 'dispensing'
    ScreenResult:
        name: 'result'
    ScreenCardAnim:
        name: 'cardanim'
    ScreenSaver:
        name: 'screensaver'
    AdminPinScreen:
        name: 'adminpin'
    AdminMenuScreen:
        name: 'adminmenu'
    ScreenSaverCfg:
        name: 'savercfg'
    AdminIpScreen:
        name: 'adminip'

<ScreenInsert>:
    BoxLayout:
        orientation: 'vertical'
        HeaderBar:
        BoxLayout:
            orientation: 'vertical'
            padding: [30, 20]
            spacing: 10
            Label:
                id: ins_title
                text: "Deslice para seleccionar su tarjeta"
                font_size: '32sp'
                bold: True
                color: 1, 1, 1, 1
                size_hint_y: None
                height: 50
                halign: 'center'
                valign: 'middle'
                text_size: self.size
            Label:
                id: ins_sub
                text: "(Deslice izquierda/derecha y presione una tarjeta)"
                font_size: '15sp'
                color: 0.667, 0.667, 0.667, 1
                size_hint_y: None
                height: 25
                halign: 'center'
                valign: 'middle'
                text_size: self.size
            ScrollView:
                id: card_scroll
                size_hint_y: None
                height: 300
                do_scroll_x: True
                do_scroll_y: False
                scroll_wheel_distance: 20
                BoxLayout:
                    id: card_container
                    orientation: 'horizontal'
                    size_hint_x: None
                    width: self.minimum_width
                    spacing: 20
                    padding: [0, 20, 0, 20]

<ScreenPin>:
    BoxLayout:
        orientation: 'vertical'
        HeaderBar:
        Widget:
            size_hint_y: 1
        Label:
            id: pin_title
            text: "Ingrese su NIP de 4 dígitos"
            font_size: '30sp'
            bold: True
            size_hint_y: None
            height: 50
            halign: 'center'
            valign: 'middle'
            text_size: self.size
        AnchorLayout:
            size_hint_y: None
            height: 92
            Label:
                id: nip_display
                text: ""
                font_size: '44sp'
                bold: True
                color: 0.067, 0.067, 0.067, 1
                size_hint: None, None
                size: 300, 70
                halign: 'center'
                valign: 'middle'
                text_size: self.size
                canvas.before:
                    Color:
                        rgba: 1, 1, 1, 1
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [8]
        AnchorLayout:
            size_hint_y: None
            height: 262
            GridLayout:
                cols: 3
                spacing: 10
                size_hint: None, None
                size: 320, 262
                NumKey:
                    text: "1"
                    on_release: root.append_nip("1")
                NumKey:
                    text: "2"
                    on_release: root.append_nip("2")
                NumKey:
                    text: "3"
                    on_release: root.append_nip("3")
                NumKey:
                    text: "4"
                    on_release: root.append_nip("4")
                NumKey:
                    text: "5"
                    on_release: root.append_nip("5")
                NumKey:
                    text: "6"
                    on_release: root.append_nip("6")
                NumKey:
                    text: "7"
                    on_release: root.append_nip("7")
                NumKey:
                    text: "8"
                    on_release: root.append_nip("8")
                NumKey:
                    text: "9"
                    on_release: root.append_nip("9")
                ClearKey:
                    text: "BORRAR"
                    on_release: root.clear_nip()
                NumKey:
                    text: "0"
                    on_release: root.append_nip("0")
                EnterKey:
                    text: "ENTRAR"
                    on_release: root.submit_nip()
        AnchorLayout:
            size_hint_y: None
            height: 78
            PinCancelButton:
                text: "CANCELAR OPERACIÓN"
                size_hint: None, None
                size: 320, 58
                on_release: app.eject_card()
        Widget:
            size_hint_y: 1

<ScreenMenu>:
    BoxLayout:
        orientation: 'vertical'
        HeaderBar:
        BoxLayout:
            orientation: 'vertical'
            padding: [80, 40]
            spacing: 30
            Widget:
                size_hint_y: 1
            Label:
                id: menu_title
                text: "Seleccione una operación"
                font_size: '32sp'
                bold: True
                size_hint_y: None
                height: 50
                halign: 'center'
                valign: 'middle'
                text_size: self.size
            AnchorLayout:
                size_hint_y: None
                height: 90
                GridLayout:
                    cols: 2
                    spacing: 20
                    size_hint: None, None
                    size: 695, 90
                    MenuButton:
                        id: menu_withdraw
                        text: "RETIRO DE EFECTIVO"
                        on_release: app.go_to('amount')
                    MenuButton:
                        id: menu_balance
                        text: "CONSULTA DE SALDO"
                        on_release: app.start_transaction(0, False)
            AnchorLayout:
                size_hint_y: None
                height: 80
                CancelButton:
                    id: menu_cancel
                    text: "CANCELAR Y RETIRAR TARJETA"
                    size_hint: None, None
                    size: 432, 60
                    on_release: app.eject_card()
            Widget:
                size_hint_y: 1

<ScreenAmount>:
    BoxLayout:
        orientation: 'vertical'
        HeaderBar:
        BoxLayout:
            orientation: 'vertical'
            padding: [60, 25]
            spacing: 20
            Label:
                id: amt_title
                text: "Seleccione la cantidad a retirar"
                font_size: '30sp'
                bold: True
                size_hint_y: None
                height: 45
                halign: 'center'
                valign: 'middle'
                text_size: self.size
            AnchorLayout:
                size_hint_y: None
                height: 340
                GridLayout:
                    cols: 2
                    spacing: 15
                    size_hint: None, None
                    size: 700, 340
                    AtmButton:
                        text: "$ 100 MXN"
                        on_release: app.start_transaction(100, True)
                    AtmButton:
                        text: "$ 200 MXN"
                        on_release: app.start_transaction(200, True)
                    AtmButton:
                        text: "$ 500 MXN"
                        on_release: app.start_transaction(500, True)
                    AtmButton:
                        text: "$ 1,000 MXN"
                        on_release: app.start_transaction(1000, True)
                    AtmButton:
                        text: "$ 2,000 MXN"
                        on_release: app.start_transaction(2000, True)
                    AtmButton:
                        text: "$ 3,000 MXN"
                        on_release: app.start_transaction(3000, True)
                    AtmButton:
                        text: "$ 5,000 MXN"
                        on_release: app.start_transaction(5000, True)
                    CancelButton:
                        id: amt_back
                        text: "REGRESAR"
                        on_release: app.go_to('menu')

<ScreenProcessing>:
    BoxLayout:
        orientation: 'vertical'
        HeaderBar:
        BoxLayout:
            orientation: 'vertical'
            padding: [60, 40]
            spacing: 20
            Label:
                id: proc_msg
                text: "Procesando por red Fortinet ZTNA..."
                font_size: '30sp'
                bold: True
            Label:
                id: timer_lbl
                text: "Tiempo restante: 30s"
                font_size: '22sp'
                color: 0.95, 0.61, 0.07, 1
                bold: True
            Label:
                id: iso_proc_lbl
                text: "[SYS] Conectando al Core Bancario (192.168.27.35)..."
                font_size: '16sp'
                color: 0.18, 0.80, 0.44, 1
                halign: 'left'
                valign: 'top'
                text_size: self.size
                padding: [15, 15]
                canvas.before:
                    Color:
                        rgba: 0, 0, 0, 0.85
                    Rectangle:
                        pos: self.pos
                        size: self.size

<ScreenDispensing>:
    BoxLayout:
        orientation: 'vertical'
        HeaderBar:
        BoxLayout:
            orientation: 'vertical'
            padding: [40, 20]
            spacing: 10
            Label:
                id: disp_title
                text: "Contando billetes..."
                font_size: '30sp'
                bold: True
                size_hint_y: None
                height: 45
            Label:
                id: disp_sub
                text: "Por favor espere"
                font_size: '20sp'
                size_hint_y: None
                height: 30
            FloatLayout:
                id: bill_area
                Widget:
                    size_hint: None, None
                    size: 420, 22
                    pos_hint: {'center_x': 0.5, 'top': 0.95}
                    canvas:
                        Color:
                            rgba: 0.05, 0.05, 0.05, 1
                        RoundedRectangle:
                            pos: self.pos
                            size: self.size
                            radius: [6]

<ScreenResult>:
    BoxLayout:
        orientation: 'vertical'
        HeaderBar:
        BoxLayout:
            orientation: 'vertical'
            padding: [60, 25]
            spacing: 18
            Label:
                id: res_title
                text: "Operación Exitosa"
                font_size: '32sp'
                bold: True
                color: 0.18, 0.80, 0.44, 1
                size_hint_y: None
                height: 45
            Label:
                id: res_detail
                text: "Saldo Disponible: $0.00 MXN"
                font_size: '26sp'
                bold: True
                size_hint_y: None
                height: 55
                canvas.before:
                    Color:
                        rgba: 0, 0, 0, 0.4
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [8]
            Label:
                id: res_iso
                text: "[SYS] Tráfico SASE Inspeccionado:"
                font_size: '15sp'
                color: 0.18, 0.80, 0.44, 1
                halign: 'left'
                valign: 'top'
                text_size: self.size
                padding: [15, 12]
                canvas.before:
                    Color:
                        rgba: 0, 0, 0, 0.85
                    Rectangle:
                        pos: self.pos
                        size: self.size
            BoxLayout:
                orientation: 'horizontal'
                spacing: 30
                size_hint_y: None
                height: 65
                AtmButton:
                    id: res_again
                    text: "OTRO MOVIMIENTO"
                    background_color: 0.95, 0.61, 0.07, 1
                    on_release: app.go_to('menu')
                CancelButton:
                    id: res_eject
                    text: "RETIRAR TARJETA"
                    on_release: app.eject_card()

<AdminPinScreen>:
    BoxLayout:
        orientation: 'vertical'
        HeaderBar
        Widget:
            size_hint_y: 1
        Label:
            text: root.title
            font_size: '28sp'
            bold: True
            size_hint_y: None
            height: 45
            halign: 'center'
            valign: 'middle'
            text_size: self.size
        Label:
            text: root.msg
            font_size: '18sp'
            color: 0.95, 0.61, 0.07, 1
            size_hint_y: None
            height: 30
            halign: 'center'
            valign: 'middle'
            text_size: self.size
        AnchorLayout:
            size_hint_y: None
            height: 92
            Label:
                text: root.pin_display
                font_size: '44sp'
                bold: True
                color: 0.067, 0.067, 0.067, 1
                size_hint: None, None
                size: 300, 70
                halign: 'center'
                valign: 'middle'
                text_size: self.size
                canvas.before:
                    Color:
                        rgba: 1, 1, 1, 1
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [8]
        AnchorLayout:
            size_hint_y: None
            height: 262
            GridLayout:
                cols: 3
                spacing: 10
                size_hint: None, None
                size: 320, 262
                NumKey:
                    text: "1"
                    on_release: root.append_digit("1")
                NumKey:
                    text: "2"
                    on_release: root.append_digit("2")
                NumKey:
                    text: "3"
                    on_release: root.append_digit("3")
                NumKey:
                    text: "4"
                    on_release: root.append_digit("4")
                NumKey:
                    text: "5"
                    on_release: root.append_digit("5")
                NumKey:
                    text: "6"
                    on_release: root.append_digit("6")
                NumKey:
                    text: "7"
                    on_release: root.append_digit("7")
                NumKey:
                    text: "8"
                    on_release: root.append_digit("8")
                NumKey:
                    text: "9"
                    on_release: root.append_digit("9")
                ClearKey:
                    id: admin_pin_clear
                    text: "BORRAR"
                    on_release: root.clear()
                NumKey:
                    text: "0"
                    on_release: root.append_digit("0")
                EnterKey:
                    id: admin_pin_enter
                    text: "ENTRAR"
                    on_release: root.submit()
        AnchorLayout:
            size_hint_y: None
            height: 78
            PinCancelButton:
                id: admin_pin_cancel
                text: "CANCELAR"
                size_hint: None, None
                size: 320, 58
                on_release: root.cancel()
        Widget:
            size_hint_y: 1

<AdminMenuScreen>:
    BoxLayout:
        orientation: 'vertical'
        HeaderBar
        BoxLayout:
            orientation: 'vertical'
            padding: [50, 15]
            spacing: 12
            Label:
                id: admin_menu_title
                text: "Menú de Administración"
                font_size: app.sfont(28)
                bold: True
                size_hint_y: None
                height: app.s(45)
                halign: 'center'
                valign: 'middle'
                text_size: self.size
            GridLayout:
                cols: 2
                spacing: 12
                size_hint_y: None
                height: 100
                AtmButton:
                    id: admin_lang_btn
                    text: "Idioma: Español"
                    on_release: app.toggle_language()
                AtmButton:
                    id: admin_tz_btn
                    text: "Zona Horaria: CDMX"
                    on_release: app.toggle_timezone()
            BoxLayout:
                orientation: 'horizontal'
                spacing: 12
                size_hint_y: None
                height: 60
                Label:
                    id: admin_backend_lbl
                    text: "Backend IP:"
                    font_size: app.sfont(20)
                    bold: True
                    size_hint_x: None
                    width: app.s(140)
                    halign: 'left'
                    valign: 'middle'
                    text_size: self.size
                Button:
                    id: backend_ip_value
                    text: "192.168.27.35"
                    background_normal: ''
                    background_color: 0.925, 0.941, 0.945, 1
                    color: 0.2, 0.2, 0.2, 1
                    font_size: app.sfont(22)
                    bold: True
                    on_release: app.open_admin_ip()
                AtmButton:
                    id: admin_test_btn
                    text: "PROBAR"
                    size_hint_x: None
                    width: 120
                    on_release: app.test_backend()
            Label:
                id: admin_frontend_ip
                text: "IP Frontend: —"
                font_size: app.sfont(18)
                color: 0.64, 0.70, 0.78, 1
                size_hint_y: None
                height: app.s(26)
                halign: 'center'
                valign: 'middle'
                text_size: self.size
            Label:
                id: admin_status
                text: ""
                font_size: app.sfont(16)
                color: 0.95, 0.61, 0.07, 1
                size_hint_y: None
                height: app.s(28)
                halign: 'center'
                valign: 'middle'
                text_size: self.size
            GridLayout:
                cols: 3
                spacing: 10
                size_hint_y: None
                height: app.s(225)
                AtmButton:
                    id: admin_change_pin
                    text: "CAMBIAR NIP"
                    on_release: app.open_change_pin()
                AtmButton:
                    id: admin_saver_btn
                    text: "SALVAPANTALLAS"
                    on_release: app.open_saver_cfg()
                AtmButton:
                    id: admin_mute_btn
                    text: "SILENCIO"
                    on_release: app.toggle_mute()
                CancelButton:
                    id: admin_poweroff
                    text: "APAGAR"
                    on_release: app.do_poweroff()
                AtmButton:
                    id: admin_reboot
                    text: "REINICIAR"
                    on_release: app.do_reboot()
                AtmButton:
                    id: admin_reset_balance
                    text: "RESET SALDOS"
                    on_release: app.reset_cards_balance()
                CancelButton:
                    id: admin_close
                    text: "CERRAR"
                    on_release: app.close_admin()
                AtmButton:
                    id: admin_resolution_btn
                    text: "RESOLUCIÓN"
                    on_release: app.cycle_resolution()
            Widget:
                size_hint_y: 1

<ScreenSaverCfg>:
    BoxLayout:
        orientation: 'vertical'
        HeaderBar
        BoxLayout:
            orientation: 'vertical'
            padding: [50, 20]
            spacing: 12
            Label:
                id: saver_cfg_title
                text: "Salvapantallas y Pantalla"
                font_size: '28sp'
                bold: True
                size_hint_y: None
                height: 45
                halign: 'center'
                valign: 'middle'
                text_size: self.size
            BoxLayout:
                orientation: 'horizontal'
                spacing: 10
                size_hint_y: None
                height: 60
                Label:
                    id: saver_start_lbl
                    text: "Iniciar salvapantallas:"
                    font_size: '20sp'
                    bold: True
                    size_hint_x: None
                    width: 300
                    halign: 'left'
                    valign: 'middle'
                    text_size: self.size
                Label:
                    id: saver_value_lbl
                    text: "2m"
                    font_size: '22sp'
                    bold: True
                    color: 0.95, 0.61, 0.07, 1
                    halign: 'center'
                    valign: 'middle'
                    text_size: self.size
            GridLayout:
                cols: 5
                spacing: 8
                size_hint_y: None
                height: 60
                AtmButton:
                    id: saver_off_btn
                    text: "No"
                    on_release: root.set_saver(0)
                AtmButton:
                    text: "30s"
                    on_release: root.set_saver(30)
                AtmButton:
                    text: "1m"
                    on_release: root.set_saver(60)
                AtmButton:
                    text: "2m"
                    on_release: root.set_saver(120)
                AtmButton:
                    text: "5m"
                    on_release: root.set_saver(300)
            BoxLayout:
                orientation: 'horizontal'
                spacing: 10
                size_hint_y: None
                height: 60
                Label:
                    id: screenoff_lbl
                    text: "Apagar pantalla:"
                    font_size: '20sp'
                    bold: True
                    size_hint_x: None
                    width: 300
                    halign: 'left'
                    valign: 'middle'
                    text_size: self.size
                Label:
                    id: screenoff_value_lbl
                    text: "No"
                    font_size: '22sp'
                    bold: True
                    color: 0.95, 0.61, 0.07, 1
                    halign: 'center'
                    valign: 'middle'
                    text_size: self.size
            GridLayout:
                cols: 5
                spacing: 8
                size_hint_y: None
                height: 60
                AtmButton:
                    id: screenoff_off_btn
                    text: "No"
                    on_release: root.set_screenoff(0)
                AtmButton:
                    text: "1m"
                    on_release: root.set_screenoff(60)
                AtmButton:
                    text: "2m"
                    on_release: root.set_screenoff(120)
                AtmButton:
                    text: "5m"
                    on_release: root.set_screenoff(300)
                AtmButton:
                    text: "10m"
                    on_release: root.set_screenoff(600)
            Label:
                text: ""
                size_hint_y: 1
            AnchorLayout:
                size_hint_y: None
                height: 78
                CancelButton:
                    id: saver_cfg_back
                    text: "VOLVER"
                    size_hint: None, None
                    size: 320, 58
                    on_release: root.back()

<AdminIpScreen>:
    BoxLayout:
        orientation: 'vertical'
        HeaderBar
        Widget:
            size_hint_y: 1
        Label:
            id: admin_ip_title
            text: "Configurar Backend IP"
            font_size: '26sp'
            bold: True
            size_hint_y: None
            height: 45
            halign: 'center'
            valign: 'middle'
            text_size: self.size
        Label:
            text: root.msg
            font_size: '18sp'
            color: 0.95, 0.61, 0.07, 1
            size_hint_y: None
            height: 30
            halign: 'center'
            valign: 'middle'
            text_size: self.size
        AnchorLayout:
            size_hint_y: None
            height: 92
            Label:
                text: root.value
                font_size: '40sp'
                bold: True
                color: 0.067, 0.067, 0.067, 1
                size_hint: None, None
                size: 460, 70
                halign: 'center'
                valign: 'middle'
                text_size: self.size
                canvas.before:
                    Color:
                        rgba: 1, 1, 1, 1
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [8]
        AnchorLayout:
            size_hint_y: None
            height: 262
            GridLayout:
                cols: 3
                spacing: 10
                size_hint: None, None
                size: 320, 262
                NumKey:
                    text: "1"
                    on_release: root.append_digit("1")
